<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ginkgo.Domain\Ginkgo.Domain.csproj" />
    <ProjectReference Include="..\Ginkgo.Plugin.Abstractions\Ginkgo.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\Ginkgo.Shared\Ginkgo.Shared.csproj" />
    <ProjectReference Include="..\Ginkgo.Infrastructure\Ginkgo.Infrastructure.csproj" />
    <ProjectReference Include="..\Ginkgo.Realtime\Ginkgo.Realtime.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

{
  "$comment": "开发环境配置（优先级高于 appsettings.json）。",
  "Urls": "http://0.0.0.0:5288",

  "Logging": {
    "$comment": "开发期日志级别。",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "$comment": "开发期 Serilog 配置，输出到控制台与滚动文件（保留 14 天）。",
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ]
  },

  "Debug": {
    "$comment": "调试总开关与请求详情日志（开发默认开启）。",
    "Enable": true,
    "ExposeErrors": true,
    "EnableRequestLog": true,
    "IncludeHeaders": true,
    "IncludeRequestBody": true,
    "IncludeResponseBody": true,
    "MaxBodySize": 2048,
    "RedactHeaders": "Authorization,Cookie",
    "DisableDbOpLog": false
  },

  "Jwt": {
    "$comment": "开发用 JWT 设置，生产请更换签名密钥并启用严格校验。",
    "SigningKey": "dev_signing_key_change_me_please",
    "Issuer": "ginkgo",
    "Audience": "ginkgo-clients",
    "ExpiresMinutes": 120
  },
  "Swagger": {
    "$comment": "配置需合并到 v1 文档并设置为同名 Tag 的分组。默认不配置即不启用。",
    "IncludeGroups": [ "community" ]
  },



  "DevModules": {
    "$comment": "开发期启用服务端模块预加载。",
    "EnableServer": true,
    "ServerSearch": [ "../../Module" ]
  },


  "DataScope": {
    "$comment": "数据范围（开发示例配置）。默认关闭以保持兼容，按需在本地启用验证。",
    "Enabled": false,
    "$comment_Enabled": "是否启用数据范围自动过滤（默认 false）",
    "DefaultStrategy": "DepartmentAndChildren",
    "$comment_DefaultStrategy": "默认策略：当角色未配置时采用（建议为本部门+子部门）",
    "AdminRoles": [ "ADMIN", "SUPERADMIN" ],
    "$comment_AdminRoles": "命中这些角色视为拥有全部数据（不再追加过滤）",
    "RoleStrategies": {
      "HR": "SpecifiedDepartments",
      "USER": "OwnOnly",
      "LEADER": "DepartmentAndChildren"
    },
    "$comment_RoleStrategies": "按角色指定策略（可只配部分角色，其余使用默认策略）",
    "RoleSpecifiedDepartments": {
      "HR": [ "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" ]
    },
    "$comment_RoleSpecifiedDepartments": "当策略为 SpecifiedDepartments 时列出可见部门 Id"
  }

}



<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\Ginkgo.Shared\Ginkgo.Shared.csproj" />
    <ProjectReference Include="..\Ginkgo.Application\Ginkgo.Application.csproj" />
    <ProjectReference Include="..\Ginkgo.Domain\Ginkgo.Domain.csproj" />
    <ProjectReference Include="..\Ginkgo.Infrastructure\Ginkgo.Infrastructure.csproj" />
    <ProjectReference Include="..\Ginkgo.Realtime\Ginkgo.Realtime.csproj" />
    <ProjectReference Include="..\Ginkgo.Plugin.Abstractions\Ginkgo.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\Ginkgo.ServerToolkit\Ginkgo.ServerToolkit.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SqlSugarCore" Version="5.1.4.200" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning.ApiExplorer" Version="5.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude any accidentally generated module code under this project tree -->
    <Compile Remove="src/Module/**" />
    <EmbeddedResource Remove="src/Module/**" />
    <None Include="src/Module/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- 复制 Install 目录下的静态文件到输出目录 -->
    <Content Include="Install\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- resource 目录由 SDK 默认包含，只需设置复制行为 -->
    <Content Update="resource\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 从仓库根目录复制 SQL 安装脚本到输出的 resource 目录 -->
    <Content Include="..\..\..\resource\mysql_install.sql" Link="resource\mysql_install.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 菜单初始化脚本 -->
    <Content Include="..\..\..\resource\mysql_init_menus.sql" Link="resource\mysql_init_menus.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- PostgreSQL 14+ 版本 -->
    <!-- 结构补丁脚本（历史实例升级用） -->
    <Content Include="..\..\..\resource\mysql_patch_add_module_scope_columns.sql" Link="resource\mysql_patch_add_module_scope_columns.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\resource\pg_patch_add_module_scope_columns.sql" Link="resource\pg_patch_add_module_scope_columns.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\resource\mssql_patch_add_module_scope_columns.sql" Link="resource\mssql_patch_add_module_scope_columns.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!--
    发布时自动收集已安装的 DLL 编译包模块到 $(PublishDir)modules/<id>/<version>/server/
    详见 Ginkgo.Api.Modules.targets 的说明
  -->
  <Import Project="Ginkgo.Api.Modules.targets" />
</Project>